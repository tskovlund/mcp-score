{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tskovlund/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Newest MuseScore Studio release the integration tests run against",
      "managerFilePatterns": [
        "/^tests/integration/musescore-versions\\.json$/"
      ],
      "matchStrings": ["\"latest\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "musescore/MuseScore",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "git-cliff pinned in the Release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["uvx git-cliff==(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "git-cliff",
      "datasourceTemplate": "pypi"
    }
  ]
}
